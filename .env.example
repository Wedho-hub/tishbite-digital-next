# Copy to .env.local and fill in real values. Never commit .env.local.

NEXT_PUBLIC_SITE_URL=https://www.tishbitedigital.co.za

# MongoDB Atlas connection string
MONGO_URI=

# Admin auth
JWT_SECRET=

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PayFast
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# Zoho SMTP (all outbound email — contact form, lead-magnet delivery,
# subscriber broadcasts/newsletters)
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
CONTACT_NOTIFY_EMAIL=

# --- Lead funnels (audit/scorecard/pricing-guide/checklist/call) ---
# Subscriber capture and email delivery are self-hosted (see
# models/Subscriber.js, app/api/subscribers/route.js, lib/leadOffers.js) —
# no third-party list/campaign service needed.

# Meta Pixel ID (Events Manager > your Pixel > Pixel ID). Leave unset or
# starting with REPLACE_ to skip loading the Pixel — used to fire a "Lead"
# event on /thank-you.
NEXT_PUBLIC_FB_PIXEL_ID=REPLACE_WITH_META_PIXEL_ID

# GA4 Measurement ID (Admin > Data Streams > your stream > Measurement ID,
# looks like G-XXXXXXXXXX). Leave unset or starting with REPLACE_ to skip
# loading GA — used to fire a "generate_lead" event on /thank-you.
NEXT_PUBLIC_GA_MEASUREMENT_ID=REPLACE_WITH_GA4_MEASUREMENT_ID
